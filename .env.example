# Copy to .env for local runs. Never commit real values.
BW_ENV=local
BW_LOG_LEVEL=INFO

# memory | pgvector
BW_VECTOR_BACKEND=memory
BW_DATABASE_URL=postgresql://bluewhale:localdev@localhost:5432/bluewhale

# hashing (offline, tests) | fastembed (BGE-small, production)
BW_EMBEDDING_BACKEND=hashing
# lexical | cross-encoder
BW_RERANKER_BACKEND=lexical

# Comma separated, in fallback order: bedrock, azure_openai, local
BW_LLM_PROVIDERS=local
AWS_REGION=us-east-1
BW_BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BW_BEDROCK_GUARDRAIL_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Leave empty to use Entra ID (managed identity)
AZURE_OPENAI_API_KEY=

# Comma separated API keys for the HTTP API (required outside local)
BW_API_KEYS=
BW_RATE_LIMIT_PER_MINUTE=60

# Export spans with OpenTelemetry (pip install .[otel])
BW_OTEL=0
